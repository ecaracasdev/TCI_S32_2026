# Claves del backend y de la base. Copiá este archivo a .env (no se versiona) y completá los valores necesarios.
#
#   cp .env.example .env
#
# Generá cada valor con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Mínimo 32 bytes. Usá un valor distinto para cada clave y para cada entorno.

# Opcional: firma la sesión, el estado OAuth y los tokens del servicio genérico.
AUTH_SIGNING_KEY=

# Firma los JWT del login local. HS256 exige al menos 32 bytes.
CLAVE_JWT=

# Contraseña de PostgreSQL: la usan el servicio db y el backend para conectarse.
POSTGRES_PASSWORD=
